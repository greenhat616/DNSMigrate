# =====================================================================
# dns-migrate — copy DNS records between providers via --from / --to.
# Only the providers you reference with --from/--to need to be filled in.
# =====================================================================

# The DNS zone operated on, used as both the source and target zone,
# e.g. example.com. (DNSPOD_DOMAIN is still accepted as a legacy alias.)
DOMAIN=example.com

# ===== DNSPod (Tencent Cloud) =====
# Create API keys at https://console.cloud.tencent.com/cam/capi
DNSPOD_SECRET_ID=your-tencent-secret-id
DNSPOD_SECRET_KEY=your-tencent-secret-key

# ===== Aliyun ESA (Edge Security Acceleration) =====
# Create API keys at https://ram.console.aliyun.com/manage/ak
ALIBABA_CLOUD_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
# Region & endpoint (ESA is centrally served from cn-hangzhou)
ESA_REGION_ID=cn-hangzhou
# Optional: override the API endpoint. Defaults to esa.<region>.aliyuncs.com
# ESA_ENDPOINT=esa.cn-hangzhou.aliyuncs.com
# Target site. If ESA_SITE_ID is empty, the site is resolved by matching
# ESA_SITE_NAME (defaults to DOMAIN) against ListSites.
# ESA_SITE_ID=1234567890123
# ESA_SITE_NAME=example.com
# When ESA is the target, import proxyable (A/AAAA/CNAME) records as proxied.
ESA_PROXIED=false

# ===== Cloudflare =====
# Create a scoped API token (Zone : DNS : Edit) at
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Optional: skip zone-name resolution by pinning the zone id.
# CLOUDFLARE_ZONE_ID=your-zone-id
# When Cloudflare is the target, import proxyable records as proxied (orange cloud).
CLOUDFLARE_PROXIED=false
