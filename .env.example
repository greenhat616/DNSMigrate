# ===== DNSPod (Tencent Cloud) =====
# Create API keys at https://console.cloud.tencent.com/cam/capi
DNSPOD_SECRET_ID=your-tencent-secret-id
DNSPOD_SECRET_KEY=your-tencent-secret-key
# The source domain whose records will be exported, e.g. example.com
DNSPOD_DOMAIN=example.com

# ===== Aliyun ESA (Edge Security Acceleration) =====
# Create API keys at https://ram.console.aliyun.com/manage/ak
ALIBABA_CLOUD_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-aliyun-access-key-secret

# Region & endpoint (ESA is centrally served from cn-hangzhou)
ESA_REGION_ID=cn-hangzhou
# Optional: override the API endpoint. Defaults to esa.<region>.aliyuncs.com
# ESA_ENDPOINT=esa.cn-hangzhou.aliyuncs.com

# Target site. If ESA_SITE_ID is empty, the tool resolves it by matching
# ESA_SITE_NAME (defaults to DNSPOD_DOMAIN) against ListSites.
# ESA_SITE_ID=1234567890123
# ESA_SITE_NAME=example.com

# Whether imported A/AAAA/CNAME records are proxied through ESA's edge.
# Keep false for a 1:1 DNS-only migration. (true|false)
ESA_PROXIED=false
