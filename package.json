{
  "name": "dns-migrate",
  "version": "2.0.0",
  "description": "Copy DNS records between providers (DNSPod, Aliyun ESA, Cloudflare) via a neutral intermediate model",
  "main": "dist/index.js",
  "bin": {
    "dns-migrate": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "dnspod",
    "aliyun",
    "esa",
    "cloudflare",
    "dns",
    "migration"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@alicloud/esa20240910": "^3.2.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "cloudflare": "^4.5.0",
    "dotenv": "^17.4.2",
    "tencentcloud-sdk-nodejs-dnspod": "^4.1.213"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
